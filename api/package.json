{
  "name": "kavi-solutions-be",
  "version": "0.1.0",
  "private": true,
  "description": "Kavi Solutions backend \u2014 NestJS + PostgreSQL (Drizzle) + Better Auth + MinIO.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,scripts,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,scripts,test}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "ts-node -r tsconfig-paths/register scripts/seed.ts",
    "user:create": "ts-node -r tsconfig-paths/register scripts/create-user.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@better-auth/drizzle-adapter": "1.7.18",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "@types/body-parser": "^1.19.6",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.18",
    "body-parser": "^2.4.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "nodemailer": "7.0.13",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.3.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "^8.11.11",
    "@types/supertest": "6.0.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.70.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "roots": [
      "<rootDir>",
      "<rootDir>/../scripts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node"
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/db/drizzle/migrations/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
