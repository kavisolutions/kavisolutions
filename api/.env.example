# --- Server ---
PORT=3200
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://kavisolutions.in

# --- PostgreSQL ---
DATABASE_URL=postgres://kavi:kavi@localhost:5436/kavi_solutions

# --- Better Auth ---
BETTER_AUTH_SECRET=change-me-32-chars-minimum-secret
BETTER_AUTH_URL=http://localhost:3200
# Public frontend URL used for email links / OAuth redirects
FRONTEND_URL=http://localhost:3000

# Google OAuth (optional — leave blank to disable the Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails that are always admins regardless of their DB role
ADMIN_EMAILS=kavitha@kavisolutions.in,tejasimma36@gmail.com

# --- SMTP (contact form + auth emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=kavisolutions1@gmail.com
SMTP_PASS=
CONTACT_EMAIL=kavisolutions1@gmail.com

# --- MinIO / S3 ---
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=avatars
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Public base URL for objects (MinIO behind nginx, or CDN)
S3_PUBLIC_URL=http://localhost:9002/avatars
