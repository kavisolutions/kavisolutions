{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Kavi Solutions design tokens. Source of truth: app/app/globals.css, app/components/*, app/app/admin/page.tsx. Colors are intentionally limited to the values already used in the application.",
  "brand": {
    "logo": {
      "$type": "color",
      "background": { "$value": "#06060F" },
      "blue": { "$value": "#2563EB" },
      "cyan": { "$value": "#06B6D4" },
      "violet": { "$value": "#8B5CF6" }
    }
  },
  "public": {
    "surface": {
      "$type": "color",
      "ink": { "$value": "#0B1220", "$description": "Page background" },
      "inkSoft": { "$value": "#111C2E", "$description": "Stat tiles, raised panels" },
      "glass": { "$value": "#121D2FD6", "$description": "rgba(18,29,47,0.84)" },
      "glassBorder": { "$value": "#94A3B824", "$description": "rgba(148,163,184,0.14)" },
      "white03": { "$value": "#FFFFFF08" },
      "white05": { "$value": "#FFFFFF0D" },
      "white10": { "$value": "#FFFFFF1A" },
      "white15": { "$value": "#FFFFFF26" },
      "divider": { "$value": "#FFFFFF0D" }
    },
    "text": {
      "$type": "color",
      "primary": { "$value": "#F7F9FC" },
      "mist": { "$value": "#A5B3C7", "$description": "Body copy and secondary labels" },
      "fog": { "$value": "#7889A0", "$description": "Captions and quiet metadata" },
      "accent": { "$value": "#91B4FF", "$description": "Highlighted words and text links" }
    },
    "action": {
      "$type": "color",
      "primary": { "$value": "#175CD3", "$description": "Primary CTA background" },
      "primaryHover": { "$value": "#1849A9" },
      "onPrimary": { "$value": "#FFFFFF" },
      "secondaryBorder": { "$value": "#FFFFFF26" }
    },
    "semantic": {
      "$type": "color",
      "success": { "$value": "#34D399" },
      "successSoft": { "$value": "#6EE7B7" },
      "warning": { "$value": "#FBBF24" },
      "error": { "$value": "#F87171" },
      "errorStrong": { "$value": "#EF4444" },
      "info": { "$value": "#38BDF8" }
    },
    "effect": {
      "glow": { "$value": "0 8px 24px -14px rgba(59,130,246,0.72)" },
      "lift": { "$value": "0 1px 2px rgba(0,0,0,0.24), 0 18px 42px -24px rgba(0,0,0,0.62)" },
      "glassBlur": { "$value": "16px" },
      "orbBlue": { "$value": "#3B82F6" },
      "orbViolet": { "$value": "#8B5CF6" },
      "selection": { "$value": "#8B5CF666" }
    }
  },
