    "lime": {
      "$type": "color",
      "from": { "$value": "#84CC16" },
      "to": { "$value": "#22C55E" }
    }
  },
  "admin": {
    "light": {
      "surface": {
        "$type": "color",
        "background": { "$value": "hsl(210 40% 98%)" },
        "card": { "$value": "#FFFFFF" },
        "popover": { "$value": "#FFFFFF" }
      },
      "text": {
        "$type": "color",
        "foreground": { "$value": "hsl(222.2 47.4% 11.2%)" },
        "muted": { "$value": "hsl(215.4 16.3% 46.9%)" },
        "primaryForeground": { "$value": "hsl(210 40% 98%)" }
      },
      "action": {
        "$type": "color",
        "primary": { "$value": "hsl(221.2 83.2% 53.3%)" },
        "secondary": { "$value": "hsl(210 40% 96.1%)" },
        "accent": { "$value": "hsl(210 40% 96.1%)" },
        "destructive": { "$value": "hsl(0 84.2% 60.2%)" },
        "ring": { "$value": "hsl(221.2 83.2% 53.3%)" }
      },
      "border": {
        "$type": "color",
        "default": { "$value": "hsl(214.3 31.8% 91.4%)" },
        "input": { "$value": "hsl(214.3 31.8% 88%)" }
      }
    },
    "dark": {
      "surface": {
        "$type": "color",
        "background": { "$value": "hsl(222 47% 7%)" },
        "card": { "$value": "hsl(222 40% 11%)" },
        "popover": { "$value": "hsl(222 40% 11%)" }
      },
      "text": {
        "$type": "color",
        "foreground": { "$value": "hsl(210 40% 98%)" },
        "muted": { "$value": "hsl(215 20.2% 65.1%)" },
        "primaryForeground": { "$value": "hsl(210 40% 98%)" }
      },
      "action": {
        "$type": "color",
        "primary": { "$value": "hsl(217.2 91.2% 59.8%)" },
        "secondary": { "$value": "hsl(217.2 32.6% 16%)" },
        "accent": { "$value": "hsl(217.2 32.6% 18%)" },
        "destructive": { "$value": "hsl(0 62.8% 50.6%)" },
        "ring": { "$value": "hsl(217.2 91.2% 59.8%)" }
      },
      "border": {
        "$type": "color",
        "default": { "$value": "hsl(217.2 32.6% 18%)" },
        "input": { "$value": "hsl(217.2 32.6% 22%)" }
      }
    }
