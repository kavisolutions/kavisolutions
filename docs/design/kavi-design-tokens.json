  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "display": { "$value": ["Space Grotesk", "ui-sans-serif", "system-ui", "sans-serif"] },
      "body": { "$value": ["Geist", "ui-sans-serif", "system-ui", "sans-serif"] },
      "mono": { "$value": ["Geist Mono", "ui-monospace", "monospace"] }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "fontSize": {
      "$type": "dimension",
      "eyebrow": { "$value": "11px" },
      "caption": { "$value": "12px" },
      "small": { "$value": "14px" },
      "body": { "$value": "16px" },
      "bodyLarge": { "$value": "18px" },
      "cardTitle": { "$value": "18px" },
      "cardTitleLarge": { "$value": "24px" },
      "sectionTitleMobile": { "$value": "30px" },
      "sectionTitle": { "$value": "48px" },
      "pageTitleMobile": { "$value": "36px" },
      "pageTitle": { "$value": "60px" },
      "hero": { "$value": "72px" }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.08 },
      "heading": { "$value": 1.2 },
      "body": { "$value": 1.7 }
    },
    "letterSpacing": {
      "$type": "dimension",
      "tight": { "$value": "-0.02em" },
      "normal": { "$value": "0" },
      "eyebrow": { "$value": "0.2em" }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "10px" },
    "xl": { "$value": "12px" },
    "2xl": { "$value": "16px" },
    "3xl": { "$value": "24px" },
    "pill": { "$value": "999px" }
