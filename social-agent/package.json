{
  "name": "social-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "import:media": "tsx scripts/import-media.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.3",
    "@napi-rs/canvas": "^1.1.0",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.1.0",
    "node-cron": "^3.0.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true
  }
}
