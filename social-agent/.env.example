# --- server ---
PORT=3300
HOST=127.0.0.1
PUBLIC_BASE_URL=https://social.example.com
# Optional. Use when /media is exposed on a different URL than the app, e.g.
# https://kavisolutions.in/social-media (nginx maps it to :3300/media/).
PUBLIC_MEDIA_BASE_URL=
# 32 random bytes, hex encoded. Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace_me_with_openssl_rand_hex_32
DATABASE_PATH=./data/app.db
PUBLIC_MEDIA_DIR=./data/public
# Shared with the Kavi API as SOCIAL_AGENT_ADMIN_TOKEN.
ADMIN_TOKEN=replace_with_long_random_string
TZ=Asia/Kolkata

# --- scheduler ---
ENABLE_SCHEDULER=false
POST_SCHEDULE=0 9 * * *
TOPIC_POOL=Lessons from shipping a side project,One mistake I see in API design,How we debug production issues
PUBLISH_TARGETS=linkedin,facebook,instagram

# --- planned images (a year of images on a calendar) ---
# Drafts the image whose date has arrived, writes the caption from the photo,
# and sends the draft to Telegram for approval.
ENABLE_MEDIA_SCHEDULER=true
MEDIA_POST_SCHEDULE=30 8 * * *
# Older planned images are marked missed after this many days of downtime.
MEDIA_CATCHUP_DAYS=7
MEDIA_MAX_PER_RUN=1
# true = publish immediately after the draft is written (no Telegram approval).
MEDIA_AUTO_PUBLISH=false
# original | portrait (4:5) | landscape (5:4)
MEDIA_IMAGE_ASPECT=original

# --- linkedin (developer portal > app > Auth) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202501

# --- meta / facebook + instagram ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# --- telegram bot ---
TELEGRAM_BOT_TOKEN=
# send /start to the bot after creating it, it replies with your chat id
TELEGRAM_CHAT_ID=

# --- llm + image gen ---
# LLM_PROVIDER: openai | gemini | groq | cloudflare | pollinations | none
#   auto-detect: OPENAI_API_KEY -> GEMINI_API_KEY -> GROQ_API_KEY -> CLOUDFLARE_API_TOKEN -> pollinations
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Gemini (free tier). Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Groq (free tier, fast captions). Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudflare Workers AI (free tier ~2000 images/day). Get token:
#   https://dash.cloudflare.com/profile/api-tokens -> Custom Token -> Account > Workers AI > Read
# Account ID: dash.cloudflare.com -> URL path segment, or sidebar on any zone overview
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_IMAGE_STEPS=6
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4

# IMAGE_PROVIDER: cloudflare | wikimedia | gemini | pexels | openai | pollinations | none
#   auto-detect: OPENAI_API_KEY -> GEMINI_API_KEY -> CLOUDFLARE_API_TOKEN -> PEXELS_API_KEY -> pollinations
IMAGE_PROVIDER=
IMAGE_MODEL=gpt-image-1

# Wikimedia Commons (free, real photos, no key). Only CC0/CC-BY/PD by default.
WIKIMEDIA_BASE_URL=https://commons.wikimedia.org/w/api.php
WIKIMEDIA_USER_AGENT=social-agent/1.0 (you@example.com)
WIKIMEDIA_ATTRIBUTION_ONLY=true

# Pexels real stock photos (free). Get key: https://www.pexels.com/api/new/
PEXELS_API_KEY=

# Pollinations free fallback (no key, watermark gets auto-cropped)
POLLINATIONS_TEXT_URL=https://text.pollinations.ai
POLLINATIONS_IMAGE_URL=https://image.pollinations.ai
POLLINATIONS_MODEL=openai

# --- vision (caption from the planned image) ---
# VISION_PROVIDER: gemini | openai | cloudflare | none
#   auto-detect: GEMINI_API_KEY -> OPENAI_API_KEY -> CLOUDFLARE_API_TOKEN
VISION_PROVIDER=
GEMINI_VISION_MODEL=gemini-2.5-flash
OPENAI_VISION_MODEL=gpt-4o-mini
CLOUDFLARE_VISION_MODEL=@cf/llava-hf/llava-1.5-7b-hf

# --- Google Drive import ---
# Share the folder with a service account (recommended) or, for a folder
# shared as "anyone with the link", set GOOGLE_API_KEY instead.
# Service account options: JSON file, JSON blob, or email + private key.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_PRIVATE_KEY_BASE64=
GOOGLE_API_KEY=

# --- brand voice ---
BRAND_NAME=
BRAND_AUDIENCE=software engineers and startup founders
BRAND_TONE=helpful, practical, confident, no hype, no emojis
