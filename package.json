{
  "name": "kavi-solutions",
  "version": "0.1.0",
  "private": true,
  "description": "Kavi Solutions monorepo — Next.js frontend (app/) + NestJS backend (api/).",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app run build",
    "start": "npm --prefix app run start",
    "lint": "npm --prefix app run lint",
    "test": "npm --prefix app run test",
    "dev:api": "npm --prefix api run start:dev",
    "build:api": "npm --prefix api run build",
    "start:api": "npm --prefix api run start:prod",
    "dev:social": "npm --prefix social-agent run dev",
    "build:social": "npm --prefix social-agent run build",
    "start:social": "npm --prefix social-agent run start",
    "import:media": "npm --prefix social-agent run import:media --",
    "lint:api": "npm --prefix api run lint",
    "test:api": "npm --prefix api test",
    "lint:all": "npm run lint && npm run lint:api",
    "build:all": "npm run build:api && npm run build",
    "test:all": "npm test && npm run test:api",
    "typecheck": "npm --prefix api run type-check",
    "db:migrate": "npm --prefix api run db:migrate",
    "deploy": "bash deploy/deploy.sh"
  }
}
