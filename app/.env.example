# URL of the kavi-solutions-be (NestJS) API. Requests to /api/* from the
# browser are proxied here so auth cookies stay first-party.
BACKEND_URL=http://localhost:3200

# /survey (Survey & Research Solutions) and /financial (Financial Services)
# are switched on and off from the admin panel — Settings → Live pages. There
# is no environment variable to set. See docs/survey-page.md and
# docs/financial-page.md.
