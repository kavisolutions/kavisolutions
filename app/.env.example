# URL of the kavi-solutions-be (NestJS) API. Requests to /api/* from the
# browser are proxied here so auth cookies stay first-party.
BACKEND_URL=http://localhost:3200

# Publishes /survey (Survey & Research Solutions). Read at BUILD time — the page
# is prerendered, so setting it only on the running process has no effect.
# Leave unset/false to keep the page returning 404. See docs/survey-page.md.
SURVEY_PAGE_ENABLED=false

# Publishes /financial (Financial Services). Also build-time.
# See docs/financial-page.md.
FINANCIAL_PAGE_ENABLED=false
